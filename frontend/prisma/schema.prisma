generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String     @id @default(cuid())
  name          String
  category      String?
  barcode       String?    @unique
  salePrice     Decimal    @db.Decimal(10, 2)
  unitsPerPack  Int?
  packSalePrice Decimal?   @db.Decimal(10, 2)
  minimumStock  Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  saleItems     SaleItem[]
  saleLines     SaleLine[]

  lots Lot[]
}

model Lot {
  id        String     @id @default(cuid())
  productId String
  lotCode   String?
  quantity  Int        @default(0)
  unitCost  Decimal    @db.Decimal(10, 2)
  expiresAt DateTime?  @db.Date
  createdAt DateTime   @default(now())
  saleItems SaleItem[]

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, expiresAt])
}

model Sale {
  id                 String          @id @default(cuid())
  total              Decimal         @db.Decimal(10, 2)
  paymentMethod      String?
  isDelivery         Boolean         @default(false)
  deliveryStatus     DeliveryStatus?
  deliveryFee        Decimal         @default(0) @db.Decimal(10, 2)
  deliveryAddress    String?
  deliveryNotes      String?
  createdAt          DateTime        @default(now())
  status             SaleStatus      @default(COMPLETED)
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  cancelledByUser    User?           @relation("SaleCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  lines              SaleLine[]
  customerId         String?
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creditMovement     CreditMovement?
  createdByUserId    String?
  createdByUser      User?           @relation("SaleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String
  lotId      String
  saleLineId String?
  quantity   Int
  unitPrice  Decimal? @db.Decimal(10, 2)
  unitCost   Decimal  @db.Decimal(10, 2)

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot      Lot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  saleLine SaleLine? @relation(fields: [saleLineId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([lotId])
  @@index([saleLineId])
}

model SaleLine {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  saleMode     SaleMode
  quantity     Int
  baseQuantity Int
  unitPrice    Decimal  @db.Decimal(10, 2)

  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations SaleItem[]

  @@index([saleId])
  @@index([productId])
}

enum CreditMovementType {
  CHARGE
  PAYMENT
  REVERSAL
}

enum DeliveryStatus {
  PENDING
  IN_ROUTE
  DELIVERED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum SaleMode {
  UNIT
  PACK
}

enum UserRole {
  ADMIN
  OPERATOR
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sales           Sale[]
  creditMovements CreditMovement[]
}

model CreditMovement {
  id            String             @id @default(cuid())
  customerId    String
  saleId        String?            @unique
  type          CreditMovementType
  amount        Decimal            @db.Decimal(10, 2)
  paymentMethod String?
  notes         String?
  createdAt     DateTime           @default(now())
  reversalOfId  String?            @unique
  reversalOf    CreditMovement?    @relation("CreditMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    CreditMovement?    @relation("CreditMovementReversal")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
}

model User {
  id                String        @id @default(cuid())
  name              String
  pinHash           String
  role              UserRole      @default(OPERATOR)
  isActive          Boolean       @default(true)
  failedPinAttempts Int           @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime      @default(now())
  cancelledSales    Sale[]        @relation("SaleCanceller")
  updatedAt         DateTime      @updatedAt
  sales             Sale[]        @relation("SaleCreator")
  sessions          UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String     @id @default(cuid())
  name         String
  category     String?
  barcode      String?    @unique
  salePrice    Decimal    @db.Decimal(10, 2)
  minimumStock Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  saleItems    SaleItem[]

  lots Lot[]
}

model Lot {
  id        String     @id @default(cuid())
  productId String
  lotCode   String?
  quantity  Int        @default(0)
  unitCost  Decimal    @db.Decimal(10, 2)
  expiresAt DateTime?  @db.Date
  createdAt DateTime   @default(now())
  saleItems SaleItem[]

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, expiresAt])
}

model Sale {
  id              String          @id @default(cuid())
  total           Decimal         @db.Decimal(10, 2)
  paymentMethod   String?
  isDelivery      Boolean         @default(false)
  deliveryFee     Decimal         @default(0) @db.Decimal(10, 2)
  deliveryAddress String?
  deliveryNotes   String?
  createdAt       DateTime        @default(now())
  items           SaleItem[]
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creditMovement  CreditMovement?
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  lotId     String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot     Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([lotId])
}

enum CreditMovementType {
  CHARGE
  PAYMENT
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sales           Sale[]
  creditMovements CreditMovement[]
}

model CreditMovement {
  id            String             @id @default(cuid())
  customerId    String
  saleId        String?            @unique
  type          CreditMovementType
  amount        Decimal            @db.Decimal(10, 2)
  paymentMethod String?
  notes         String?
  createdAt     DateTime           @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
}
